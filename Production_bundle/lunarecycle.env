# LunaRecycle backend environment overrides.
# Copy/adjust as needed. Loaded by the systemd unit via EnvironmentFile.

# ── Serial ports ──────────────────────────────────────────────
# Arduino Mega pinned to its stable by-id node so ttyACM renumbering on the Pi
# cannot strand the backend on a stale device path.
LUNA_ARDUINO_PORT=/dev/serial/by-id/usb-Arduino__www.arduino.cc__0042_145323030323517080D0-if00
LUNA_ARDUINO_BAUD=115200
# Best-effort: hold DTR/RTS low before opening serial to avoid auto-reset.
# Set to 1 to enable no-reset open behavior.
LUNA_ARDUINO_NO_RESET_OPEN=1
# Small settle delay after open before first read/write.
LUNA_ARDUINO_OPEN_SETTLE_SEC=0.2
# Additional settle delay used when no-reset mode is OFF and board reboot on
# serial open is expected.
LUNA_ARDUINO_RESET_SETTLE_SEC=2.0

# Closed-loop crammer Arduino (second Mega).
# Set to that board's stable by-id node or dedicated udev symlink.
LUNA_CRAMMER_PORT=/dev/ttyACM1
LUNA_CRAMMER_BAUD=115200
# Best-effort: hold DTR/RTS low before opening serial to avoid auto-reset.
LUNA_CRAMMER_NO_RESET_OPEN=1
LUNA_CRAMMER_OPEN_SETTLE_SEC=0.2
LUNA_CRAMMER_RESET_SETTLE_SEC=2.0
LUNA_CRAMMER_TIMEOUT=1.0

# Conair dryer via USB-to-RS485 adapter.
LUNA_DRYER_PORT=/dev/ttyUSB0
LUNA_DRYER_BAUD=57600
LUNA_DRYER_ID=1
LUNA_DRYER_PARITY=N
LUNA_DRYER_STOPBITS=1
LUNA_DRYER_BYTESIZE=8
# Dryer run-state mapping for status/logging. Comma-separated integer values.
# Keep defaults unless your controller reports different run-state codes.
LUNA_DRYER_RUN_ON_VALUES=100
LUNA_DRYER_RUN_OFF_VALUES=0
# Automated dry start: enable dryer SSR first, then wait before commanding run.
LUNA_DRYER_SSR_PREHEAT_DELAY_SEC=15.0

# ── Web server ────────────────────────────────────────────────
# 0.0.0.0 = reachable from other LAN devices; 127.0.0.1 = Pi only.
LUNA_HOST=0.0.0.0
LUNA_PORT=5055
# AGITATOR_MOVE can be intentionally long (consecutive spins + pauses).
# Keep backend command timeout above worst-case move duration.
LUNA_AGITATOR_MOVE_TIMEOUT=45.0

# ── Drying automation mixer ramp ──────────────────────────────
# Soft-start the screw motor instead of jumping straight to the full PWM.
LUNA_MIX_RAMP_STEPS=5
LUNA_MIX_RAMP_STEP_SEC=0.20

# ── Discharge shake (post-dry drop-down assist) ───────────────
# Alternate mixer direction every N seconds during discharge.
LUNA_DISCHARGE_SHAKE=1
LUNA_DISCHARGE_SHAKE_SEG_SEC=5
# Pause at zero before each shake direction flip after the first segment.
LUNA_DISCHARGE_SHAKE_STOP_SEC=1.5

# ── Print-feed automation ──────────────────────────────────────
# Agitator metering power for /api/feed/start defaults.
LUNA_FEED_AGITATOR_PCT=75

# ── Viewer endpoints (served by /viewer) ───────────────────────
# Leave blank to keep camera/printer cards in offline mode.
LUNA_VIEWER_DRYER_CAM_URL=
LUNA_VIEWER_PRINTER_CAM_URL=
LUNA_VIEWER_PRINTER_API_URL=

# ── Moonraker live monitoring / FE auto-control ─────────────────
# Required for extrusion-gated feed and heater-temp FE auto toggle.
# Example: ws://127.0.0.1:7125/websocket
LUNA_MOONRAKER_WS_URL=ws://127.0.0.1:7125/websocket
# Persist Moonraker cumulative telemetry so reconnects/restarts keep progress.
LUNA_MOONRAKER_STATE_PATH=/opt/lunarecycle/moonraker_state.json
# Minimum seconds between state-file writes.
LUNA_MOONRAKER_STATE_FLUSH_SEC=2.0
# Extrusion considered active above this live extruder velocity.
LUNA_MOONRAKER_EXTRUDER_VEL_MIN=0.01
# Conversion used for live extruder-rotation metrics from motion_report.live_position.
# Set to your extruder's linear units per one full extruder rotation.
# Keep at 1.0 if your Moonraker live_position E already tracks rotations.
LUNA_MOONRAKER_EXTRUDER_UNITS_PER_ROTATION=1.0
# Extruder-ratio test vacuum behavior:
# after each completed agitator spin cycle, run at requested vacuum_pct for
# this many seconds, then fall back to idle percent.
LUNA_RATIO_TEST_VACUUM_BOOST_SEC=5.0
LUNA_RATIO_TEST_VACUUM_IDLE_PCT=15
LUNA_RATIO_TEST_MIX_PWM=200
LUNA_RATIO_TEST_MIX_PWM_REV=255
# Ratio controller: use crammer load to trigger airlock turns.
# 1 = enabled, 0 = use spin-threshold-only behavior.
LUNA_RATIO_USE_CRAMMER_LOAD=1
# Trigger a home when crammer-reported load drops to this percent or lower.
LUNA_RATIO_CRAMMER_LOW_LOAD_PCT=30.0
# Rearm threshold = LOW_LOAD_PCT + HYST_PCT to avoid chatter.
LUNA_RATIO_CRAMMER_LOAD_HYST_PCT=5.0
# Minimum seconds between low-load-triggered home events.
LUNA_RATIO_CRAMMER_RETRIGGER_SEC=8.0
# After each air-lock turn completes, wait this long before deciding whether
# load recovered above threshold.
LUNA_RATIO_POST_HOME_RECOVERY_CHECK_SEC=8.0
LUNA_RATIO_POST_HOME_RECOVERY_LOAD_PCT=60.0
# Require this many consecutive unrecovered homes before recovery runs.
LUNA_RATIO_POST_HOME_RECOVERY_REQUIRED_HOMES=2
# Recovery sequence timings: STOP -> REV -> STOP -> resume FWD.
LUNA_RATIO_POST_HOME_RECOVERY_STOP1_SEC=3.0
LUNA_RATIO_POST_HOME_RECOVERY_REVERSE_SEC=5.0
LUNA_RATIO_POST_HOME_RECOVERY_STOP2_SEC=3.0
# Stage-2 post-reverse hold window before Stage-3 escalation.
LUNA_RATIO_POST_HOME_RECOVERY_STAGE2_CHECK_SEC=15.0
# FE auto ON when any extruder heater temp >= this threshold.
LUNA_MOONRAKER_FE_TEMP_C=100.0
# Retry delay after FE command failure.
LUNA_MOONRAKER_FE_RETRY_SEC=5.0

# Tip: to lock ports across reboots regardless of plug order, create udev
# rules that symlink by serial number, then point the vars at the symlinks,
# e.g. LUNA_ARDUINO_PORT=/dev/lunarecycle-arduino
